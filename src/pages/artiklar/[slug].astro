---
import ArticlePage from "../../components/ArticlePage.astro";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
import { getRelatedArticles, publishedArticles } from "../../data/articles";
import { getPublishedTreatmentBySlug, type Treatment } from "../../data/treatments";
import BaseLayout from "../../layouts/BaseLayout.astro";

export function getStaticPaths() {
  return publishedArticles.map((article) => ({
    params: { slug: article.slug },
    props: { article }
  }));
}

const { article } = Astro.props;
const relatedTreatmentEntries = article.relatedTreatments.map((slug) => ({
  slug,
  treatment: getPublishedTreatmentBySlug(slug)
}));
const missingRelatedTreatmentSlugs = relatedTreatmentEntries
  .filter((entry) => !entry.treatment)
  .map((entry) => entry.slug);

if (missingRelatedTreatmentSlugs.length > 0) {
  throw new Error(
    `Article "${article.slug}" has unresolved related treatments: ${missingRelatedTreatmentSlugs.join(", ")}`
  );
}

const hasResolvedTreatment = (
  entry: (typeof relatedTreatmentEntries)[number]
): entry is { slug: string; treatment: Treatment } => Boolean(entry.treatment);

const relatedTreatments = relatedTreatmentEntries
  .filter(hasResolvedTreatment)
  .map((entry) => entry.treatment);
const relatedArticles = getRelatedArticles(article);
---

<BaseLayout
  title={article.seoTitle}
  description={article.seoDescription}
  canonicalPath={`/artiklar/${article.slug}/`}
  ogImage={article.image}
>
  <Header />
  <main>
    <ArticlePage
      article={article}
      relatedTreatments={relatedTreatments}
      relatedArticles={relatedArticles}
    />
  </main>
  <Footer />

  <script>
    import "../../scripts/motion";
  </script>
</BaseLayout>
