---
import BookingHub from "../components/BookingHub.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import SubpageHero from "../components/SubpageHero.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Boka tid | PNK Beauty Klinik"
  description="Boka behandling eller konsultation hos PNK Beauty Klinik i Borås via Bokadirekt."
  canonicalPath="/boka/"
>
  <Header />
  <main>
    <SubpageHero
      eyebrow="Boka"
      title="Boka tid hos PNK Beauty"
      image="/images/pnk/clinic-reception.jpg"
      actions={[
        { label: "Starta bokning", href: "#boka-online" }
      ]}
    />

    <BookingHub />
  </main>
  <Footer />

  <script>
    import "../scripts/motion";
  </script>
</BaseLayout>
