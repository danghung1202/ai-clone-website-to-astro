---
import { assets, bookingUrl, services } from "../data/home";
---

<section class="services-section section-reveal" id="behandlingar">
  <div class="section-heading">
    <img src={assets.stripeIcons} width="252" height="78" alt="" />
    <div>
      <h2 class="home-carousel-h2">BEHANDLINGAR FÖR HUD,<br />FORM OCH NATURLIG LYSTER</h2>
      <h3 class="home-carousel-h3">Injektioner, hudvård och skönhetsbehandlingar i Borås.</h3>
    </div>
  </div>

  <div class="home-carousel" data-home-carousel>
    <div class="e-n-carousel swiper offset-right" role="region" aria-roledescription="carousel" aria-label="Carousel" dir="ltr">
      <div class="swiper-wrapper" aria-live="polite">
        {services.map((service, index) => (
          <div
            class="swiper-slide"
            id={index === 0 ? "injektioner" : index === 3 ? "hudvard" : undefined}
            data-slide={index + 1}
            role="group"
            aria-roledescription="slide"
            aria-label={`${index + 1} of ${services.length}`}
          >
            <div class="carousel-container-parent">
              <a
                class="carousel-container"
                href={service.href}
                style={`--image:url(${service.image});--bg-position:${service.backgroundPosition};--bg-size:${service.backgroundSize}`}
              >
                <p class="carousel-eyebrow">{service.eyebrow}</p>
                <div class="carousel-heading">
                  <h2>
                    {service.titleLines.map((line, lineIndex) => (
                      <>
                        {lineIndex > 0 && <br />}
                        {line}
                      </>
                    ))}
                  </h2>
                </div>
                <p class="carousel-copy">{service.copy}</p>
                <div class="carousel-chips" aria-label={`${service.title} behandlingar`}>
                  {service.chips.map((chip) => <span>{chip}</span>)}
                </div>
              </a>
            </div>
          </div>
        ))}
      </div>

      <button class="elementor-swiper-button elementor-swiper-button-prev" type="button" aria-label="Previous slide">
        <svg aria-hidden="true" viewBox="0 0 320 512" focusable="false">
          <path d="M34.52 239.03 228.87 44.69c9.37-9.37 24.57-9.37 33.94 0l22.67 22.67c9.36 9.36 9.37 24.52.04 33.9L131.49 256l154.02 154.75c9.34 9.38 9.32 24.54-.04 33.9l-22.67 22.67c-9.37 9.37-24.57 9.37-33.94 0L34.52 272.97c-9.37-9.37-9.37-24.57 0-33.94z" />
        </svg>
      </button>
      <button class="elementor-swiper-button elementor-swiper-button-next" type="button" aria-label="Next slide">
        <svg aria-hidden="true" viewBox="0 0 320 512" focusable="false">
          <path d="M285.48 272.97 91.13 467.31c-9.37 9.37-24.57 9.37-33.94 0l-22.67-22.67c-9.36-9.36-9.38-24.52-.04-33.9L188.51 256 34.48 101.26c-9.34-9.38-9.32-24.54.04-33.9l22.67-22.67c9.37-9.37 24.57-9.37 33.94 0L285.48 239.03c9.37 9.37 9.37 24.57 0 33.94z" />
        </svg>
      </button>
    </div>
  </div>

  <div class="services-action">
    <a class="pill-link services-button" href={bookingUrl} target="_blank" rel="noreferrer">Boka via Bokadirekt</a>
  </div>
</section>
