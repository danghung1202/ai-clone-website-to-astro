---
interface FAQItem {
  question: string;
  answer: string;
}

interface Props {
  items: FAQItem[];
  title?: string;
}

const { items, title = "Vanliga frågor" } = Astro.props;
---

{
  items.length > 0 && (
    <section class="faq-block subpage-reveal" aria-labelledby="faq-heading">
      <p class="section-kicker">Frågor och svar</p>
      <h2 id="faq-heading">{title}</h2>
      <div class="faq-block-list">
        {items.map((item) => (
          <details>
            <summary>{item.question}</summary>
            <p>{item.answer}</p>
          </details>
        ))}
      </div>
    </section>
  )
}
