---
import { assets } from "../data/home";
import { footerBottomLinks, footerGroups } from "../data/navigation";
import { site } from "../data/site";

const mobileFooterLinks = [
  { label: "Priser", href: "/priser/" },
  { label: "Presentkort", href: "/presentkort/" },
  { label: "Artiklar", href: "/artiklar/" }
];
---

<footer class="site-footer">
  <div class="site-footer-shell">
    <div class="site-footer-top">
      <div class="site-footer-brand">
        <img src={assets.logoWhite} width="136" height="63" alt="PNK Beauty Klinik" />
        <p>
          Skönhetsklinik i Borås för injektioner, hudvård och behandlingar med fokus på naturliga resultat,
          trygg rådgivning och ett personligt bemötande.
        </p>
        <a class="footer-booking-link" href={site.bookingUrl} target="_blank" rel="noreferrer">Boka via Bokadirekt</a>
      </div>

      <div class="site-footer-contact-panel">
        <p>Kontakt</p>
        <address class="site-footer-contact">
          <strong>{site.name}</strong>
          <span>{site.address.street}</span>
          <span>{site.address.postalCode} {site.address.city}</span>
          <a href={`tel:${site.phoneMachine}`}>{site.phone}</a>
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </address>
      </div>
    </div>

    <div class="footer-mobile-compact" aria-label="Mobil sidfot">
      <div class="footer-mobile-primary">
        <a class="footer-mobile-booking" href={site.bookingUrl} target="_blank" rel="noreferrer">Boka tid</a>
        <a href={`tel:${site.phoneMachine}`}>
          <svg class="footer-action-icon footer-phone-icon" aria-hidden="true" viewBox="0 0 24 24" focusable="false">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.12 4.2 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.12.9.32 1.77.59 2.61a2 2 0 0 1-.45 2.11L8 9.69a16 16 0 0 0 6.31 6.31l1.25-1.25a2 2 0 0 1 2.11-.45c.84.27 1.71.47 2.61.59A2 2 0 0 1 22 16.92Z"></path>
          </svg>
          <span>Ring</span>
        </a>
        <a href={`mailto:${site.email}`}>
          <svg class="footer-action-icon footer-mail-icon" aria-hidden="true" viewBox="0 0 24 24" focusable="false">
            <path d="M4 4h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Z"></path>
            <path d="m22 7-8.97 5.7a2 2 0 0 1-2.06 0L2 7"></path>
          </svg>
          <span>Maila</span>
        </a>
      </div>
      <p class="footer-mobile-address">
        {site.address.street}, {site.address.postalCode} {site.address.city}
      </p>
      <nav class="footer-mobile-links" aria-label="Snabblänkar">
        {
          mobileFooterLinks.map((item) => (
            <a href={item.href}>{item.label}</a>
          ))
        }
      </nav>
    </div>

    <div class="site-footer-groups footer-treatment-group">
      {
        footerGroups.map((group) => (
          <nav aria-label={group.title}>
            <h2>{group.title}</h2>
            {group.links.map((item) => (
              <a
                href={item.href}
                target={item.external ? "_blank" : undefined}
                rel={item.external ? "noreferrer" : undefined}
              >
                {item.label}
              </a>
            ))}
          </nav>
        ))
      }
    </div>

    <div class="footer-bottom">
      <span>© {new Date().getFullYear()} {site.name}</span>
      <nav aria-label="Juridiska länkar">
        {
          footerBottomLinks.map((item) => (
            <a href={item.href}>{item.label}</a>
          ))
        }
      </nav>
    </div>
  </div>
</footer>
