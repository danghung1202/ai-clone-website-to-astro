---
import type { Article } from "../data/articles";

interface Props {
  article: Article;
}

const { article } = Astro.props;
---

<article class="article-card subpage-reveal">
  <a href={`/artiklar/${article.slug}/`}>
    <img src={article.image} alt="" loading="lazy" />
    <div class="article-card-body">
      <p class="article-card-eyebrow">{article.eyebrow}</p>
      <h2>{article.title}</h2>
      <p>{article.summary}</p>
      <span>Läs artikeln</span>
    </div>
  </a>
</article>
