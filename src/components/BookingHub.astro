---
import { site } from "../data/site";
import {
  publishedCategories,
  publishedTreatments,
  type PriceOption,
  type Treatment
} from "../data/treatments";

type BookingService = {
  id: string;
  title: string;
  treatmentTitle: string;
  categoryTitle: string;
  slug: string;
  eyebrow: string;
  summary: string;
  description: string;
  price: string;
  duration: string;
  practitioner: string;
  chips: string[];
  thumbClass: string;
};

const cleanTitle = (title: string) => title.replace(/\s+i Borås$/i, "");

const titleForOption = (treatment: Treatment, option: PriceOption) => {
  const treatmentTitle = cleanTitle(treatment.title);
  const label = option.label?.trim();

  if (!label || label.toLowerCase() === treatmentTitle.toLowerCase()) return treatmentTitle;
  if (label.toLowerCase() === "fillers") return treatmentTitle;
  if (label.toLowerCase() === "prophilo") return treatmentTitle;

  return label;
};

const thumbClassFor = (treatment: Treatment) => {
  const value = `${treatment.slug} ${treatment.category}`.toLowerCase();

  if (value.includes("presentkort")) return "booking-thumb-gift";
  if (value.includes("piercing")) return "booking-thumb-piercing";
  if (value.includes("massage")) return "booking-thumb-massage";
  if (value.includes("makeup")) return "booking-thumb-makeup";
  if (value.includes("naglar") || value.includes("manikyr") || value.includes("pedikyr")) return "booking-thumb-nails";
  if (value.includes("lash") || value.includes("frans")) return "booking-thumb-lashes";
  if (value.includes("plasma")) return "booking-thumb-plasma";
  if (value.includes("peeling") || value.includes("biorepeel") || value.includes("dubai")) return "booking-thumb-peeling";
  if (value.includes("microneedling") || value.includes("bb-glow")) return "booking-thumb-microneedling";
  if (value.includes("ansikts") || value.includes("marina") || value.includes("pure-cell") || value.includes("microdermabrasion")) {
    return "booking-thumb-facial";
  }
  if (value.includes("filler") || value.includes("lapp")) return "booking-thumb-fillers";

  return "booking-thumb-injections";
};

const serviceGroups = publishedCategories
  .map((category) => {
    const services = publishedTreatments
      .filter((treatment) => treatment.category === category.slug)
      .flatMap((treatment) => {
        const options = treatment.priceOptions.length
          ? treatment.priceOptions
          : [{ label: cleanTitle(treatment.title), price: treatment.priceFrom, duration: treatment.duration }];

        return options.map((option, optionIndex): BookingService => ({
          id: `${treatment.slug}-${optionIndex}`,
          title: titleForOption(treatment, option),
          treatmentTitle: cleanTitle(treatment.title),
          categoryTitle: cleanTitle(category.title),
          slug: treatment.slug,
          eyebrow: treatment.eyebrow,
          summary: treatment.summary,
          description: treatment.description,
          price: option.price || treatment.priceFrom,
          duration: option.duration || treatment.duration,
          practitioner: treatment.practitioner,
          chips: treatment.chips.slice(0, 3),
          thumbClass: thumbClassFor(treatment)
        }));
      });

    return { ...category, services };
  })
  .filter((category) => category.services.length);

const serviceCount = serviceGroups.reduce((count, group) => count + group.services.length, 0);

type CalendarDay = {
  day?: string;
  label?: string;
  value?: string;
  slots?: string[];
  empty?: boolean;
  available?: boolean;
};

const calendarWeeks: CalendarDay[][] = [
  [
    { day: "6", label: "Mån", value: "Måndag 6 juli" },
    { day: "7", label: "Tis", value: "Tisdag 7 juli" },
    { day: "8", label: "Ons", value: "Onsdag 8 juli" },
    { day: "9", label: "Tor", value: "Torsdag 9 juli", slots: ["16:30", "17:15", "18:40"], available: true },
    { day: "10", label: "Fre", value: "Fredag 10 juli" },
    { day: "11", label: "Lör", value: "Lördag 11 juli", slots: ["14:30", "15:20", "17:10"], available: true },
    { day: "12", label: "Sön", value: "Söndag 12 juli", slots: ["14:45", "16:00", "17:30"], available: true }
  ],
  [
    { day: "13", label: "Mån", value: "Måndag 13 juli" },
    { day: "14", label: "Tis", value: "Tisdag 14 juli" },
    { day: "15", label: "Ons", value: "Onsdag 15 juli" },
    { day: "16", label: "Tor", value: "Torsdag 16 juli", slots: ["16:00", "17:40", "20:10"], available: true },
    { day: "17", label: "Fre", value: "Fredag 17 juli" },
    { day: "18", label: "Lör", value: "Lördag 18 juli", slots: ["14:30", "15:50", "18:00"], available: true },
    { day: "19", label: "Sön", value: "Söndag 19 juli", slots: ["14:30", "16:20", "17:40"], available: true }
  ],
  [
    { day: "20", label: "Mån", value: "Måndag 20 juli" },
    { day: "21", label: "Tis", value: "Tisdag 21 juli" },
    { day: "22", label: "Ons", value: "Onsdag 22 juli" },
    { day: "23", label: "Tor", value: "Torsdag 23 juli", slots: ["16:15", "18:00", "21:10"], available: true },
    { day: "24", label: "Fre", value: "Fredag 24 juli" },
    { day: "25", label: "Lör", value: "Lördag 25 juli", slots: ["14:30", "16:00", "18:20"], available: true },
    { day: "26", label: "Sön", value: "Söndag 26 juli", slots: ["14:45", "15:45", "17:30"], available: true }
  ]
];

const firstAvailableDate = calendarWeeks.flat().find((date) => date.available);
const initialDate = firstAvailableDate?.value ?? "Välj datum";
const initialSlots = firstAvailableDate?.slots ?? ["Första lediga"];

const reviews = [
  {
    initials: "UÖ",
    name: "Ulla-Britt Ö.",
    text: "Väl omhändertagen och fick bra förklaring av vad som utfördes. Fin lokal och jag är så nöjd."
  },
  {
    initials: "MG",
    name: "Marie G.",
    text: "Alltid lika nöjd med resultatet som blir efter behandlingen."
  },
  {
    initials: "MS",
    name: "Mahde S.",
    text: "Professionellt arbete, tydlig expertis och bra uppföljning efter behandling."
  }
];
---

<section
  class="booking-hub subpage-section subpage-section-cream"
  id="boka-online"
  data-booking-hub
  data-provider-ready="fresha"
  data-booking-email={site.email}
>
  <div class="subpage-shell booking-hub-shell">
    <div class="booking-provider-profile">
      <nav class="booking-breadcrumb" aria-label="Brödsmulor">
        <a href="/">Hem</a>
        <span aria-hidden="true">/</span>
        <span>Boka</span>
      </nav>

      <div class="booking-provider-top">
        <div>
          <p class="section-kicker">Boka behandling</p>
          <h2>PNK Beauty Klinik</h2>
          <p class="booking-provider-address">Brämhultsvägen 4, 504 56 Borås</p>
        </div>

        <div class="booking-rating-summary" aria-label="4.8 av 5 baserat på 12 betyg">
          <strong>4.8</strong>
          <span class="booking-stars" aria-hidden="true">
            <span></span><span></span><span></span><span></span><span class="is-partial"></span>
          </span>
          <a href="#booking-reviews">12 betyg</a>
        </div>
      </div>

    </div>

    <div class="booking-workflow">
      <div class="booking-workflow-step is-active">
        <span>1</span>
        <strong>Välj tjänst</strong>
      </div>
      <div class="booking-workflow-step">
        <span>2</span>
        <strong>Välj tid</strong>
      </div>
      <div class="booking-workflow-step">
        <span>3</span>
        <strong>Slutför</strong>
      </div>
    </div>

    <div class="booking-layout">
      <main class="booking-service-list" id="booking-services" aria-label="Alla tjänster">
        <section class="booking-gift-card" aria-label="Presentkort">
          <span class="booking-service-image booking-thumb-gift" aria-hidden="true"></span>
          <div>
            <p>Presentkort</p>
            <h3>Ge bort egentid</h3>
            <span>Valfritt belopp för behandlingar, hudvård eller konsultation hos PNK Beauty Klinik.</span>
          </div>
          <a class="booking-service-link" href="/presentkort/">Läs mer</a>
        </section>

        <div class="booking-service-heading">
          <div>
            <p class="section-kicker">Alla tjänster</p>
            <h2>{serviceCount} bokningsbara alternativ</h2>
          </div>
          <p>
            Välj en behandling för att öppna kalendern. Du kan fortfarande läsa mer om varje behandlingsområde innan
            du bestämmer dig.
          </p>
        </div>

        {
          serviceGroups.map((group) => (
            <section class="booking-service-group" aria-labelledby={`booking-group-${group.slug}`}>
              <button
                class="booking-service-group-head"
                type="button"
                aria-expanded="true"
                aria-controls={`booking-panel-${group.slug}`}
                data-booking-toggle
              >
                <span>
                  <strong id={`booking-group-${group.slug}`}>{cleanTitle(group.title)}</strong>
                  <small>{group.eyebrow}</small>
                </span>
                <em>{group.services.length}</em>
              </button>

              <div class="booking-service-group-panel" id={`booking-panel-${group.slug}`}>
                {
                  group.services.map((service) => (
                    <article class="booking-service-card is-mobile-compact">
                      <span class:list={["booking-service-image", service.thumbClass]} aria-hidden="true"></span>
                      <div class="booking-service-copy">
                        <p>{service.eyebrow}</p>
                        <h3>{service.title}</h3>
                        <span>{service.duration}</span>
                        <div class="booking-service-description">
                          <span>{service.description}</span>
                          <a href={`/behandlingar/${service.slug}/`}>Läs mer</a>
                        </div>
                        <div class="booking-service-chips" aria-label={`${service.title} etiketter`}>
                          {service.chips.map((chip) => <span>{chip}</span>)}
                        </div>
                      </div>
                      <div class="booking-service-action">
                        <span>Pris</span>
                        <strong>{service.price}</strong>
                        <button
                          class="booking-service-book"
                          type="button"
                          data-book-service={service.title}
                          data-book-treatment={service.treatmentTitle}
                          data-book-category={service.categoryTitle}
                          data-book-price={service.price}
                          data-book-duration={service.duration}
                          data-book-practitioner={service.practitioner}
                        >
                          Boka
                        </button>
                      </div>
                    </article>
                  ))
                }
              </div>
            </section>
          ))
        }

        <section class="booking-proof" id="booking-reviews" aria-label="Omdömen">
          <div class="booking-proof-head">
            <div>
              <p class="section-kicker">Omdömen</p>
              <h2>4.8 av 5</h2>
            </div>
            <span>12 betyg</span>
          </div>
          <div class="booking-review-grid">
            {
              reviews.map((review) => (
                <article>
                  <div>
                    <span>{review.initials}</span>
                    <strong>{review.name}</strong>
                  </div>
                  <p>{review.text}</p>
                </article>
              ))
            }
          </div>
        </section>

        <section class="booking-about" id="booking-about" aria-label="Om PNK Beauty Klinik">
          <p class="section-kicker">Om företaget</p>
          <h2>Professionella behandlingar i Borås</h2>
          <p>
            PNK Beauty Klinik erbjuder hudvård, injektionsbehandlingar, fransar, makeup, massage, naglar och
            piercing. Injektionsbehandlingar utförs av specialist med lång erfarenhet, och varje besök planeras efter
            dina mål, förutsättningar och önskat uttryck.
          </p>
        </section>
      </main>

      <aside class="booking-calendar-panel" data-booking-calendar aria-label="Kalender och sammanfattning" tabindex="-1">
        <div class="booking-calendar-card">
          <span class="booking-step">Kalender</span>
          <h3 data-calendar-title>Välj en behandling</h3>
          <p data-calendar-helper>
            Klicka på Boka vid en behandling så öppnas kalendern med förslag på tider.
          </p>

          <dl class="booking-calendar-summary">
            <div>
              <dt>Behandling</dt>
              <dd data-calendar-service>Ingen vald</dd>
            </div>
            <div>
              <dt>Pris</dt>
              <dd data-calendar-price>-</dd>
            </div>
            <div>
              <dt>Tid</dt>
              <dd data-calendar-duration>-</dd>
            </div>
            <div>
              <dt>Behandlare</dt>
              <dd data-calendar-practitioner>-</dd>
            </div>
          </dl>

          <div class="booking-calendar-month" aria-label="Välj datum">
            <div class="booking-calendar-month-head">
              <button type="button" aria-label="Föregående månad" disabled>‹</button>
              <strong>Juli</strong>
              <button type="button" aria-label="Nästa månad" disabled>›</button>
            </div>
            <div class="booking-calendar-weekdays" aria-hidden="true">
              <span>M</span><span>T</span><span>O</span><span>T</span><span>F</span><span>L</span><span>S</span>
            </div>
            <div class="booking-calendar-date-grid">
              {
                calendarWeeks.flat().map((date) => (
                  date.empty ? (
                    <span class="booking-calendar-date is-empty" aria-hidden="true"></span>
                  ) : (
                    <button
                      class:list={["booking-calendar-date", date.available && "is-available", date.value === initialDate && "is-active"]}
                      type="button"
                      data-book-date={date.value}
                      data-book-slots={date.slots?.join("|")}
                      aria-pressed={date.value === initialDate ? "true" : "false"}
                      disabled={!date.available}
                    >
                      <span>{date.day}</span>
                    </button>
                  )
                ))
              }
            </div>
          </div>

          <div class="booking-calendar-slots" aria-label="Välj tid">
            {
              initialSlots.map((slot, index) => (
                <button
                  class:list={[index === 0 && "is-active"]}
                  type="button"
                  data-book-time={slot}
                  aria-pressed={index === 0 ? "true" : "false"}
                >
                  {slot}
                </button>
              ))
            }
          </div>

          <label class="booking-code-field">
            <span>Kampanjkod</span>
            <input type="text" value="" placeholder="Ex. GLOWSTART" data-booking-code />
          </label>

          <dl class="booking-confirmation-list">
            <div>
              <dt>Vald dag</dt>
              <dd data-summary-day>{initialDate}</dd>
            </div>
            <div>
              <dt>Vald tid</dt>
              <dd data-summary-time>{initialSlots[0]}</dd>
            </div>
            <div>
              <dt>Kampanj</dt>
              <dd data-summary-campaign>Ingen kod</dd>
            </div>
          </dl>

          <a class="pill-link booking-complete-link" href={site.bookingUrl} target="_blank" rel="noreferrer">
            Slutför i bokningsportal
          </a>
          <a class="booking-request-link" href={`mailto:${site.email}?subject=Bokningsf%C3%B6rfr%C3%A5gan%20PNK%20Beauty`}>
            Skicka förfrågan via mail
          </a>
        </div>

        <section class="booking-side-card" id="booking-staff">
          <h3>Personal</h3>
          <div>
            <strong>Siamak Ghazanfari</strong>
            <span>Injektionspecialist: Botox, fillers, trådlyft och fettreducering</span>
          </div>
          <div>
            <strong>Shadi Dadfar</strong>
            <span>Auktoriserad hudterapeut och professionell makeupartist</span>
          </div>
        </section>
      </aside>
    </div>
  </div>
</section>

<script>
  const root = document.querySelector("[data-booking-hub]");

  if (root) {
    const serviceButtons = Array.from(root.querySelectorAll("[data-book-service]"));
    const toggleButtons = Array.from(root.querySelectorAll("[data-booking-toggle]"));
    const dateButtons = Array.from(root.querySelectorAll("[data-book-date]"));
    const slotContainer = root.querySelector(".booking-calendar-slots");
    const codeInput = root.querySelector("[data-booking-code]");
    const calendar = root.querySelector("[data-booking-calendar]");
    const requestLink = root.querySelector(".booking-request-link");
    const bookingEmail = root.getAttribute("data-booking-email") || "info@pnkbeauty.se";

    const state = {
      service: "",
      treatment: "",
      category: "",
      price: "",
      duration: "",
      practitioner: "",
      day: "Torsdag 9 juli",
      time: "16:30",
      campaign: ""
    };

    const setText = (selector, value) => {
      const element = root.querySelector(selector);
      if (element) element.textContent = value;
    };

    const updateRequestLink = () => {
      if (!(requestLink instanceof HTMLAnchorElement)) return;

      const subject = "Bokningsförfrågan PNK Beauty";
      const body = [
        `Behandling: ${state.service || "Ej vald"}`,
        `Kategori: ${state.category || "Ej vald"}`,
        `Pris: ${state.price || "Ej valt"}`,
        `Dag: ${state.day}`,
        `Tid: ${state.time}`,
        `Kampanjkod: ${state.campaign || "Ingen"}`,
        "",
        "Namn:",
        "Telefon:"
      ].join("\n");

      requestLink.href = `mailto:${bookingEmail}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
    };

    const syncCalendar = () => {
      setText("[data-calendar-title]", state.service ? "Välj datum och tid" : "Välj en behandling");
      setText(
        "[data-calendar-helper]",
        state.service
          ? `${state.service} är vald. Välj datum i kalendern och därefter en ledig tid.`
          : "Klicka på Boka vid en behandling så öppnas kalendern med förslag på tider."
      );
      setText("[data-calendar-service]", state.service || "Ingen vald");
      setText("[data-calendar-price]", state.price || "-");
      setText("[data-calendar-duration]", state.duration || "-");
      setText("[data-calendar-practitioner]", state.practitioner || "-");
      setText("[data-summary-day]", state.day);
      setText("[data-summary-time]", state.time);
      setText("[data-summary-campaign]", state.campaign || "Ingen kod");
      calendar?.classList.toggle("has-service", Boolean(state.service));
      updateRequestLink();
    };

    const setTime = (button) => {
      const time = button.getAttribute("data-book-time");
      if (!time) return;
      state.time = time;
      Array.from(root.querySelectorAll("[data-book-time]")).forEach((item) => {
        const isActive = item === button;
        item.classList.toggle("is-active", isActive);
        item.setAttribute("aria-pressed", String(isActive));
      });
      syncCalendar();
    };

    const renderSlots = (slots) => {
      if (!slotContainer) return;
      slotContainer.innerHTML = "";

      slots.forEach((slot, index) => {
        const button = document.createElement("button");
        button.type = "button";
        button.textContent = slot;
        button.dataset.bookTime = slot;
        button.classList.toggle("is-active", index === 0);
        button.setAttribute("aria-pressed", String(index === 0));
        button.addEventListener("click", () => setTime(button));
        slotContainer.append(button);
      });

      state.time = slots[0] || "Första lediga";
    };

    serviceButtons.forEach((button) => {
      button.addEventListener("click", () => {
        state.service = button.getAttribute("data-book-service") || "";
        state.treatment = button.getAttribute("data-book-treatment") || "";
        state.category = button.getAttribute("data-book-category") || "";
        state.price = button.getAttribute("data-book-price") || "";
        state.duration = button.getAttribute("data-book-duration") || "";
        state.practitioner = button.getAttribute("data-book-practitioner") || "";

        serviceButtons.forEach((item) => item.classList.toggle("is-active", item === button));
        syncCalendar();

        if (calendar instanceof HTMLElement) {
          calendar.scrollIntoView({ behavior: "smooth", block: "start" });
          calendar.focus({ preventScroll: true });
        }
      });
    });

    toggleButtons.forEach((button) => {
      button.addEventListener("click", () => {
        const panelId = button.getAttribute("aria-controls");
        const panel = panelId ? root.querySelector(`#${CSS.escape(panelId)}`) : null;
        const expanded = button.getAttribute("aria-expanded") === "true";
        button.setAttribute("aria-expanded", String(!expanded));
        panel?.toggleAttribute("hidden", expanded);
      });
    });

    dateButtons.forEach((button) => {
      button.addEventListener("click", () => {
        const date = button.getAttribute("data-book-date");
        const slots = (button.getAttribute("data-book-slots") || "").split("|").filter(Boolean);
        if (!date || !slots.length) return;
        state.day = date;
        dateButtons.forEach((item) => {
          const isActive = item === button;
          item.classList.toggle("is-active", isActive);
          item.setAttribute("aria-pressed", String(isActive));
        });
        renderSlots(slots);
        syncCalendar();
      });
    });

    codeInput?.addEventListener("input", () => {
      state.campaign = codeInput instanceof HTMLInputElement ? codeInput.value.trim() : "";
      syncCalendar();
    });

    syncCalendar();
  }
</script>
