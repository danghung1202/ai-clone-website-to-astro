---
import { assets } from "../data/home";
import { megaMenuGroups, navItems } from "../data/navigation";
import { site } from "../data/site";

const primaryNavItems = navItems.filter((item) => item.label !== "Behandlingar");
---

<header class="site-header" data-header>
  <div class="site-header-shell">
    <a class="site-logo" href="/" aria-label="PNK Beauty Klinik startsida">
      <img class="site-logo-white" src={assets.logoWhite} width="159" height="100" alt="PNK Beauty Klinik" />
      <img class="site-logo-dark" src={assets.logoDark} width="159" height="100" alt="" aria-hidden="true" />
    </a>

    <nav class="desktop-nav" aria-label="Huvudmeny">
      <button
        class="desktop-nav-link desktop-nav-trigger"
        type="button"
        aria-expanded="false"
        aria-controls="treatment-mega-menu"
        data-mega-button
      >
        Behandlingar
        <span aria-hidden="true"></span>
      </button>
      {primaryNavItems.map((item) => <a class="desktop-nav-link" href={item.href}>{item.label}</a>)}
      <a class="nav-booking-link" href="/boka/">Boka tid</a>
    </nav>

    <button
      class="menu-button"
      type="button"
      aria-controls="mobile-menu"
      aria-expanded="false"
      aria-label="Öppna meny"
      data-menu-button
    >
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>

  <div class="mega-menu" id="treatment-mega-menu" data-mega-menu>
    <div class="mega-menu-shell">
      <div class="mega-menu-category-list" role="list">
        {
          megaMenuGroups.map((group, index) => (
            <section class:list={["mega-menu-category-card", index === 0 && "is-active"]} role="listitem">
              <button
                type="button"
                aria-expanded={index === 0 ? "true" : "false"}
                data-mega-category={group.title}
              >
                <img class="mega-menu-card-image" src={group.image} alt="" loading="lazy" />
                <span>
                  <small>{group.eyebrow}</small>
                  <strong>{group.title}</strong>
                  <em>{group.links.length} behandlingar</em>
                </span>
              </button>
            </section>
          ))
        }
      </div>
      <div class="mega-menu-link-panels">
        {
          megaMenuGroups.map((group, index) => (
            <section class="mega-menu-category-links" data-mega-panel={group.title} hidden={index !== 0}>
              <div class="mega-menu-panel-copy">
                <p>{group.eyebrow}</p>
                <h2>{group.title}</h2>
                <span>{group.description}</span>
              </div>
              <div class="mega-menu-link-grid">
                <a class="mega-menu-overview-link" href={group.href}>Översikt</a>
                {group.links.map((item) => (
                  <a href={item.href}>{item.label}</a>
                ))}
              </div>
            </section>
          ))
        }
      </div>
    </div>
  </div>

  <button class="mobile-menu-backdrop" type="button" aria-label="Stäng meny" data-menu-backdrop></button>

  <nav class="mobile-nav" id="mobile-menu" aria-label="Mobil meny" data-mobile-drawer>
    <div class="mobile-nav-head">
      <span>PNK Beauty</span>
      <button type="button" aria-label="Stäng meny" data-menu-close>Stäng</button>
    </div>
    <a class="mobile-booking-link" href="/boka/">Boka tid</a>
    <div class="mobile-nav-section">
      <p>Behandlingar</p>
      {
        megaMenuGroups.map((group) => (
          <details>
            <summary>{group.title}</summary>
            <a href={group.href}>Översikt</a>
            {group.links.map((item) => <a href={item.href}>{item.label}</a>)}
          </details>
        ))
      }
    </div>
    <div class="mobile-nav-section">
      <p>Sidor</p>
      {primaryNavItems.map((item) => <a href={item.href}>{item.label}</a>)}
    </div>
    <div class="mobile-nav-contact">
      <span>{site.address.street}, {site.address.city}</span>
      <a href={`tel:${site.phoneMachine}`}>{site.phone}</a>
    </div>
  </nav>
</header>

<script>
  const header = document.querySelector("[data-header]");
  const button = document.querySelector("[data-menu-button]");
  const drawer = document.querySelector("[data-mobile-drawer]");
  const backdrop = document.querySelector("[data-menu-backdrop]");
  const closeButton = document.querySelector("[data-menu-close]");
  const megaButton = document.querySelector("[data-mega-button]");
  const megaCategoryButtons = Array.from(document.querySelectorAll("[data-mega-category]"));
  const megaPanels = Array.from(document.querySelectorAll("[data-mega-panel]"));
  const focusableSelector = "a[href], button:not([disabled]), summary, [tabindex]:not([tabindex='-1'])";
  let lastFocusedElement = null;

  const isVisibleFocusable = (element) => {
    if (!(element instanceof HTMLElement)) return false;
    const style = window.getComputedStyle(element);
    return style.display !== "none" && style.visibility !== "hidden" && element.getClientRects().length > 0;
  };

  const getDrawerFocusable = () =>
    drawer
      ? Array.from(drawer.querySelectorAll(focusableSelector)).filter(
          (element) => isVisibleFocusable(element)
        )
      : [];

  const syncHeaderTone = () => {
    header?.toggleAttribute("data-scrolled", window.scrollY > window.innerHeight * 0.7);
  };

  const setDrawerOpen = (open) => {
    if (open) {
      lastFocusedElement = document.activeElement instanceof HTMLElement ? document.activeElement : null;
    }
    button?.setAttribute("aria-expanded", String(open));
    button?.setAttribute("aria-label", open ? "Stäng meny" : "Öppna meny");
    header?.toggleAttribute("data-menu-open", open);
    drawer?.setAttribute("aria-hidden", String(!open));
    document.documentElement.toggleAttribute("data-menu-lock", open);
    if (open) {
      window.setTimeout(() => {
        const firstFocusable = getDrawerFocusable()[0];
        firstFocusable?.focus({ preventScroll: true });
      }, 40);
    } else if (lastFocusedElement?.isConnected && isVisibleFocusable(lastFocusedElement)) {
      lastFocusedElement.focus();
      lastFocusedElement = null;
    }
  };

  const setMegaOpen = (open) => {
    megaButton?.setAttribute("aria-expanded", String(open));
    header?.toggleAttribute("data-mega-open", open);
  };

  const setMegaCategory = (activeButton) => {
    if (!(activeButton instanceof HTMLElement)) return;
    const activeCategory = activeButton.dataset.megaCategory;

    megaCategoryButtons.forEach((button) => {
      if (!(button instanceof HTMLElement)) return;
      const isActive = button === activeButton;
      button.setAttribute("aria-expanded", String(isActive));
      button.closest(".mega-menu-category-card")?.classList.toggle("is-active", isActive);
    });

    megaPanels.forEach((panel) => {
      if (!(panel instanceof HTMLElement)) return;
      panel.hidden = panel.dataset.megaPanel !== activeCategory;
    });
  };

  setDrawerOpen(false);
  setMegaOpen(false);
  syncHeaderTone();
  window.addEventListener("scroll", syncHeaderTone, { passive: true });
  window.addEventListener("resize", () => {
    syncHeaderTone();
    if (window.matchMedia("(min-width: 1025px)").matches) {
      setDrawerOpen(false);
    } else {
      setMegaOpen(false);
    }
  });

  button?.addEventListener("click", () => {
    const open = button.getAttribute("aria-expanded") === "true";
    setDrawerOpen(!open);
  });

  backdrop?.addEventListener("click", () => setDrawerOpen(false));
  closeButton?.addEventListener("click", () => setDrawerOpen(false));

  drawer?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => setDrawerOpen(false));
  });

  megaButton?.addEventListener("click", () => {
    const open = megaButton.getAttribute("aria-expanded") === "true";
    setMegaOpen(!open);
  });

  megaCategoryButtons.forEach((categoryButton) => {
    categoryButton.addEventListener("click", () => {
      setMegaCategory(categoryButton);
      setMegaOpen(true);
    });
  });

  document.addEventListener("click", (event) => {
    if (!(event.target instanceof Node)) return;
    if (!header?.contains(event.target)) {
      setMegaOpen(false);
    }
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") {
      setDrawerOpen(false);
      setMegaOpen(false);
      return;
    }

    if (event.key !== "Tab" || button?.getAttribute("aria-expanded") !== "true") return;

    const focusable = getDrawerFocusable();
    const first = focusable[0];
    const last = focusable[focusable.length - 1];
    if (!first || !last) return;

    if (event.shiftKey && document.activeElement === first) {
      event.preventDefault();
      last.focus();
    } else if (!event.shiftKey && document.activeElement === last) {
      event.preventDefault();
      first.focus();
    }
  });
</script>
